      <column caption='profit margin' datatype='real' name='[Calculation_0326897825685504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='avg order value' datatype='real' name='[Calculation_0326897838092290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
